{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpdf",
  "version": "26.7.0",
  "identifier": "com.timostein.tpdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpdf",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' tile: data: blob:; connect-src 'self' tile: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
