{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpdf",
  "version": "26.7.0",
  "identifier": "com.timostein.tpdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpdf",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' tile: http://tile.localhost data: blob:; connect-src 'self' tile: http://tile.localhost ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Timo Stein",
    "copyright": "Copyright (c) 2026 Timo Stein. MIT licensed.",
    "category": "Productivity",
    "homepage": "https://github.com/tstone-1/tpdf",
    "shortDescription": "Fast, lightweight PDF viewer and editor",
    "longDescription": "A PDF viewer and editor for macOS and Windows. Every document is parsed and rendered in sandboxed worker processes with no filesystem or network authority, and every command is reachable from the command palette.",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
