diff --git a/core/fpdftext/cpdf_textpage.cpp b/core/fpdftext/cpdf_textpage.cpp
index 13ff030..6d94fd9 100644
--- a/core/fpdftext/cpdf_textpage.cpp
+++ b/core/fpdftext/cpdf_textpage.cpp
@@ -834,7 +834,35 @@ void CPDF_TextPage::CloseTempLine() {
     prev_char_is_space = true;
   }
   CFX_BidiString bidi(str, /*auto_order=*/false);
-  if (rtl_) {
+  // ActualText is already logical text. Preserve the ordering introduced for
+  // mixed-direction replacement spans. For ordinary predominantly RTL lines,
+  // restore segment reversal only when both strong ends are RTL; an LTR prefix
+  // or suffix must not move across the rest of the line.
+  using Direction = CFX_BidiChar::Direction;
+  Direction first_strong = Direction::kNeutral;
+  Direction last_strong = Direction::kNeutral;
+  size_t right_segments = 0;
+  size_t left_segments = 0;
+  for (const auto& segment : bidi) {
+    if (segment.count == 0 || (segment.direction != Direction::kRight &&
+                               segment.direction != Direction::kLeft)) {
+      continue;
+    }
+    if (first_strong == Direction::kNeutral) {
+      first_strong = segment.direction;
+    }
+    last_strong = segment.direction;
+    right_segments += segment.direction == Direction::kRight;
+    left_segments += segment.direction == Direction::kLeft;
+  }
+  const bool has_actual_text =
+      std::ranges::any_of(temp_char_list_, [](const CharInfo& info) {
+        return info.char_type() == CharType::kActualText;
+      });
+  const bool ordinary_rtl =
+      !has_actual_text && first_strong == Direction::kRight &&
+      last_strong == Direction::kRight && right_segments > left_segments;
+  if (rtl_ || ordinary_rtl) {
     bidi.SetOverallDirectionRight();
   }
   CFX_BidiChar::Direction current_direction = bidi.OverallDirection();
