{
  "name": "tpdf",
  "version": "26.10.26",
  "private": true,
  "description": "Fast, lightweight PDF viewer and editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:checks": "vite build --mode checks",
    "build:explorer": "vite build && cargo build --locked --release --manifest-path src-tauri/Cargo.toml -p tpdf-shell",
    "preview": "vite preview",
    "check": "tsc --noEmit --project tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "2.14.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5",
    "svelte-check": "^4.7.4",
    "tslib": "^2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
