# Node
node_modules/
dist/
.vite/

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/

# PDFium binaries (downloaded at build time, not vendored)
vendor/pdfium/

# Local agent overrides (per shared-memory policy)
AGENTS.local.md
# The machine-local half of the Claude Code settings: tool permissions granted on
# one box. Named rather than ignoring `.claude/` wholesale, because the sibling
# `.claude/settings.json` is the *shared* half and should stay committable.
.claude/settings.local.json

# Test corpus - may contain confidential customer documents
testdata/private/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs / scratch
*.log
scratch/

# Where the mutation harnesses keep the verdicts `--resume` reuses, and the
# backup that lets a killed run's mutation be put back. Ignored because it is
# written during the run whose tree it fingerprints -- a tracked one would make
# every fingerprint disagree with itself. See scripts/mutation_resume.py.
.mutations/

# Generated test corpus (regenerate with the testdata/make_*.py scripts)
testdata/*.pdf
# `testdata/*.pdf` is not recursive, and `testdata/abort/` holds a document that
# aborts whatever parses it --- generated like every other fixture, and the one
# least suitable for committing into a public repository.
testdata/abort/
testdata/*.txt
testdata/hostile-manifest.json
testdata/incr-manifest.json
testdata/outline-manifest.json
testdata/rotated-manifest.json
testdata/columns-manifest.json
testdata/tagged-manifest.json
testdata/multilingual-manifest.json
testdata/encodings-manifest.json
# Not "-manifest.json" on purpose: viewer_check.py binds that suffix to the
# reading-order check, and the mixed fixture makes no claim about reading order.
testdata/mixed-geometry.json
__pycache__/
